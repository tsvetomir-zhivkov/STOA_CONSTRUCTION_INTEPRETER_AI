  "description": "Entry-point filter, vector extractor and Gemini schema mapper for the Stoa blueprint pipeline.",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "blueprint-ingest": "src/index.js"
  },
